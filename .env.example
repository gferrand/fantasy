# Copy this file to .env. Never commit .env.

# Discord Developer Portal bot token.
DISCORD_BOT_TOKEN=

# Your numeric Discord user ID. The bot ignores every other author and every
# guild message or group DM.
DISCORD_ALLOWED_USER_ID=

# Server text channel used only for automatic scheduler output. On-demand
# questions and manually invoked tasks continue to reply in the bot DM.
DISCORD_SCHEDULED_CHANNEL_ID=

# Required only for private PDF reading and voice-note transcription.
OPENAI_API_KEY=
OPENAI_AUDIO_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_DOCUMENT_MODEL=gpt-4.1-mini
# General current-events questions use the Responses API with live web search.
# League, roster, waiver, and team-fit requests remain on the local Codex path.
OPENAI_WEB_MODEL=gpt-5.6-terra
OPENAI_WEB_REASONING_EFFORT=low

# Fantasy analysis is pinned to GPT-5.6 Luna with medium reasoning. Both values
# are sent explicitly so the host's global Codex defaults cannot change them.
CODEX_BIN=codex
CODEX_SANDBOX=read-only
CODEX_TIMEOUT_SECONDS=1800
# Discord-originated questions fail fast if the local Codex CLI hangs.
CODEX_INTERACTIVE_TIMEOUT_SECONDS=120
CODEX_EPHEMERAL=false
FANTASY_LOG_LEVEL=INFO
